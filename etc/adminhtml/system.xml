<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="carriers">
            <group id="envia" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Envia.com (Live Rates)</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Default OFF. Enable only after sandbox spike and catalog weight checks.</comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="sandbox" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Use Sandbox API</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>api-test.envia.com when Yes; api.envia.com when No.</comment>
                </field>
                <field id="api_token" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>API Token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Bearer token from Envia account → API Token. Never commit.</comment>
                </field>
                <field id="carriers_list" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Carriers (comma-separated)</label>
                    <comment>Envia carrier slugs, one rate call each. Example: servientrega,interrapidisimo,coordinadora. Keep ≤3 for latency.</comment>
                </field>
                <field id="parcel_max_kg" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Parcel max weight (kg)</label>
                    <comment>Above this total cart weight, Envia is skipped and mstrate handles the quote.</comment>
                    <validate>validate-number validate-greater-than-zero</validate>
                </field>
                <field id="require_dimensions" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Require product dimensions</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>If Yes, missing L/W/H on any item forces mstrate path. If No, default package dims are used.</comment>
                </field>
                <field id="default_length_cm" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Default package length (cm)</label>
                </field>
                <field id="default_width_cm" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Default package width (cm)</label>
                </field>
                <field id="default_height_cm" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Default package height (cm)</label>
                </field>
                <field id="markup_type" translate="label" type="select" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Markup type</label>
                    <source_model>DepositoTrujillo\EnviaShipping\Model\Config\Source\MarkupType</source_model>
                </field>
                <field id="markup_value" translate="label comment" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Markup value</label>
                    <comment>Percent (e.g. 10 = +10%) or fixed COP amount depending on markup type.</comment>
                </field>
                <field id="handling_fee" translate="label" type="text" sortOrder="130" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Handling fee (COP)</label>
                </field>
                <field id="cache_ttl" translate="label" type="text" sortOrder="140" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Rate cache TTL (seconds)</label>
                </field>
                <field id="timeout_ms" translate="label" type="text" sortOrder="150" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>HTTP timeout (ms)</label>
                    <comment>Per-carrier request timeout. Fail open to mstrate.</comment>
                </field>
                <field id="show_eta" translate="label" type="select" sortOrder="160" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Show delivery estimate</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="one_method_per_carrier" translate="label comment" type="select" sortOrder="165" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>One method per carrier</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Keep only the cheapest service per carrier (avoids duplicate InterRapidísimo lines).</comment>
                </field>
                <field id="hide_mstrate_when_envia" translate="label comment" type="select" sortOrder="170" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Hide mstrate when Envia succeeds</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Hybrid UX: avoid double shipping methods when live rates are available.</comment>
                </field>
                <field id="backup_rate_active" translate="label" type="select" sortOrder="180" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enable backup rate</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Shown only when Envia is eligible but all carriers fail (mstrate still available unless hidden).</comment>
                </field>
                <field id="backup_rate_price" translate="label" type="text" sortOrder="190" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Backup rate price (COP)</label>
                </field>
                <field id="backup_rate_title" translate="label" type="text" sortOrder="200" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Backup rate title</label>
                </field>
                <field id="origin_name" translate="label" type="text" sortOrder="210" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin name</label>
                </field>
                <field id="origin_phone" translate="label" type="text" sortOrder="220" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin phone</label>
                </field>
                <field id="origin_street" translate="label" type="text" sortOrder="230" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin street</label>
                </field>
                <field id="origin_city" translate="label comment" type="text" sortOrder="240" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin city name</label>
                    <comment>Human-readable; resolved to DANE code via Envia /locate for CO.</comment>
                </field>
                <field id="origin_state" translate="label comment" type="text" sortOrder="250" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin state (2-letter CO code)</label>
                    <comment>e.g. HU (Huila), AN (Antioquia), CN (Cundinamarca/Bogotá).</comment>
                </field>
                <field id="origin_postal_code" translate="label" type="text" sortOrder="260" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin postal code</label>
                </field>
                <field id="origin_country" translate="label" type="text" sortOrder="270" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Origin country</label>
                </field>
                <field id="sallowspecific" translate="label" type="select" sortOrder="280" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="290" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                </field>
                <field id="showmethod" translate="label" type="select" sortOrder="310" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Show Method if Not Applicable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="dtlocalfree" translate="label" type="text" sortOrder="115" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Local free shipping (city-scoped)</label>
                <field id="active" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>City-scoped free home delivery. Do NOT re-enable Magento core Free Shipping for this.</comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="name" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Method name</label>
                </field>
                <field id="free_cities" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Free cities (comma-separated)</label>
                    <comment>Exact city names after normalize (case-insensitive). Comma-separated city names after normalize (case-insensitive). Example: neiva,medellin</comment>
                </field>
                <field id="hide_mstrate_when_local_free" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Hide mstrate when local free applies</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Avoid showing paid table rates next to free Neiva delivery.</comment>
                </field>
                <field id="sallowspecific" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Applicable Countries</label>
                    <frontend_class>shipping-applicable-country</frontend_class>
                    <source_model>Magento\Shipping\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ship to Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                </field>
                <field id="showmethod" translate="label" type="select" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Show Method if Not Applicable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
